services:
  # Tu servidor multimedia principal
  jellyfin:
    image: jellyfin/jellyfin
    container_name: jellyfin
    volumes:
      - ./jellyfin_config:/config
      - ./biblioteca_multimedia:/data # <--- Esta es tu biblioteca principal
    ports:
      - "8096:8096"
    restart: unless-stopped

  # Tu servidor de streaming
  owncast:
    image: gabekangas/owncast:latest
    container_name: owncast
    ports:
      - "1935:1935"
      - "8080:8080"
    networks:
      - cole_net

  # El grabador automático (el script de teklynk)
  recorder:
    build: .
    container_name: owncast_recorder
    depends_on:
      - owncast
    volumes:
      # MAPEAMOS LA SALIDA DEL GRABADOR A LA ENTRADA DE JELLYFIN
      - ./biblioteca_multimedia/grabaciones_vivas:/recordings
    networks:
      - cole_net
    restart: always

networks:
  cole_net:
    driver: bridge
